NODE_ENV=development
PORT=3000

# Postgres. Matches docker-compose.yml and `pnpm dev:db`.
DATABASE_URL=postgres://talanta:talanta@localhost:5432/talanta

# Redis. Leave unset to use the in-memory store (single-process local dev only).
# REDIS_URL=redis://localhost:6379

# Secrets: at least 32 characters each. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_SECRET=

# Sign-in codes. `console` prints codes to the log; `africastalking` sends real SMS.
SMS_PROVIDER=console
# From https://account.africastalking.com -> your app -> Settings -> API Key.
# Use the username `sandbox` to test with their phone simulator first.
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# A sender ID must be approved per country before use; leave unset until it is.
# AFRICASTALKING_SENDER_ID=
SMS_ALLOWED_COUNTRIES=NG,KE,GH,ZA
# Local dev only: every phone number accepts this code. Rejected when NODE_ENV=production.
OTP_DEV_FIXED_CODE=

# Youngest age allowed to create a profile (13 or higher).
MIN_SIGNUP_AGE=13

# Number of trusted reverse proxies in front of the API (Cloudflare + load balancer).
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001
