{
  "name": "talanta",
  "version": "0.1.0",
  "private": true,
  "description": "Talanta — Africa's home for talent, culture and community.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:db": "pnpm --filter @talanta/api db:dev",
    "dev:api": "pnpm --filter @talanta/api dev",
    "dev:web": "pnpm --filter @talanta/web dev",
    "dev:usb": "node scripts/usb-link.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "pnpm --filter @talanta/design-tokens build",
    "contract": "pnpm --filter @talanta/api openapi && pnpm --filter @talanta/api-contract build"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest"
  }
}
